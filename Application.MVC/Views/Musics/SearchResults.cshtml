@model IEnumerable<Application.Models.Music>
@{
    ViewData["Title"] = "Explorar Música";
    var albums = ViewBag.Albums as List<Application.Models.Album> ?? new List<Application.Models.Album>();
    var artists = ViewBag.Artists as List<Application.Models.Identity.User> ?? new List<Application.Models.Identity.User>();
    var playlists = ViewBag.Playlists as List<Application.Models.Playlist> ?? new List<Application.Models.Playlist>();
    <link rel="stylesheet" href="~/css/search-dashboard.css" />
}

<!-- Solo mostrar para usuarios -->
@if (User.IsInRole("users"))
{
    <div class="search-dashboard">
        <form style="display: none;">
            @Html.AntiForgeryToken()
        </form>

        <!-- Header de búsqueda -->
        <div class="search-header">
            @if (ViewBag.ShowingAll == true)
            {
                <h1><i class="fas fa-compass"></i> Explorar Música</h1>
                <p>Descubre @ViewBag.ResultCount canciones disponibles</p>
            }
            else
            {
                <h1><i class="fas fa-search"></i> Resultados de Búsqueda</h1>
                <p>@ViewBag.ResultCount resultado(s) para "@ViewBag.SearchQuery"</p>
            }
        </div>

        @if (Model.Any() || albums.Any() || artists.Any() || playlists.Any())
        {
            <!-- Dashboard Grid -->
            <div class="dashboard-grid">
                <!-- Bloque 1: Canciones (Principal) -->
                <div class="dashboard-block songs-block">
                    <div class="block-header">
                        <div class="header-info">
                            <h3><i class="fas fa-music"></i> Canciones</h3>
                            <span class="block-count">@Model.Count() resultado(s)</span>
                        </div>
                        <div class="header-border songs-border"></div>
                    </div>
                    <div class="block-content">
                        @if (Model.Any())
                        {
                            @foreach (var music in Model)
                            {
                                <div class="song-item">
                                    <div class="song-number">@(Model.ToList().IndexOf(music) + 1)</div>
                                    <div class="song-cover">
                                        <i class="fas fa-music"></i>
                                    </div>
                                    <div class="song-details">
                                        <h4 class="song-title">@music.Title</h4>
                                        <p class="song-artist">@music.Artist?.FirstName @music.Artist?.LastName</p>
                                    </div>
                                    <div class="song-duration">@(music.Duration ?? "3:00")</div>
                                    <div class="song-actions">
                                        <button class="action-btn play-btn"
                                                onclick="playMusic(@music.Id, '@music.Title', '@music.Artist?.FirstName @music.Artist?.LastName', '/files/@music.FilePath', event);">
                                            <i class="fas fa-play"></i>
                                        </button>
                                        <button class="action-btn add-btn"
                                                onclick="event.stopPropagation(); showAddToPlaylistModal(@music.Id, '@music.Title');"
                                                title="Agregar a playlist">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                        <form asp-controller="Favorites" asp-action="AddMusic" method="post" style="display: inline;">
                                            <input type="hidden" name="musicId" value="@music.Id" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                            <button type="submit" class="action-btn favorite-btn" title="Agregar a favoritos">
                                                <i class="fas fa-heart"></i>
                                            </button>
                                        </form>
                                        <form asp-controller="Downloads" asp-action="DownloadMusic" method="post" style="display: inline;">
                                            <input type="hidden" name="musicId" value="@music.Id" />
                                            <button type="submit" class="action-btn download-btn" title="Descargar">
                                                <i class="fas fa-download"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-block">
                                <i class="fas fa-music fa-2x"></i>
                                <p>No se encontraron canciones</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Bloque 2: Álbumes -->
                <div class="dashboard-block albums-block">
                    <div class="block-header">
                        <div class="header-info">
                            <h3><i class="fas fa-compact-disc"></i> Álbumes</h3>
                            <span class="block-count">@albums.Count resultado(s)</span>
                        </div>
                        <div class="header-border albums-border"></div>
                    </div>
                    <div class="block-content">
                        @if (albums.Any())
                        {
                            <div class="albums-grid">
                                @foreach (var album in albums)
                                {
                                    <div class="album-item" onclick="window.location.href='@Url.Action("Details", "Albums", new { id = album.Id })'">
                                        <div class="album-cover">
                                            @if (!string.IsNullOrEmpty(album.CoverImagePath))
                                            {
                                                <img src="@album.CoverImagePath" alt="@album.Name" />
                                            }
                                            else
                                            {
                                                <i class="fas fa-compact-disc"></i>
                                            }
                                        </div>
                                        <div class="album-info">
                                            <h4 class="album-title">@album.Name</h4>
                                            <p class="album-artist">@album.Artist?.FirstName @album.Artist?.LastName</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="empty-block">
                                <i class="fas fa-compact-disc fa-2x"></i>
                                <p>No se encontraron álbumes</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Bloque 3: Artistas -->
                <div class="dashboard-block artists-block">
                    <div class="block-header">
                        <div class="header-info">
                            <h3><i class="fas fa-microphone"></i> Artistas</h3>
                            <span class="block-count">@artists.Count resultado(s)</span>
                        </div>
                        <div class="header-border artists-border"></div>
                    </div>
                    <div class="block-content">
                        @if (artists.Any())
                        {
                            @foreach (var artist in artists)
                            {
                                <div class="artist-item">
                                    <div class="artist-avatar">
                                        <i class="fas fa-user"></i>
                                    </div>
                                    <div class="artist-details">
                                        <h4 class="artist-name">@artist.FirstName @artist.LastName</h4>
                                        <p class="artist-info">@(artist.Musics?.Count ?? 0) canciones</p>
                                    </div>
                                    <div class="artist-actions">
                                        <a href="@Url.Action("Search", "Musics", new { query = artist.FirstName + " " + artist.LastName })"
                                           class="action-btn view-btn" title="Ver música">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <form asp-controller="Favorites" asp-action="AddArtist" method="post" style="display: inline;">
                                            <input type="hidden" name="artistId" value="@artist.Id" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                            <button type="submit" class="action-btn star-btn" title="Artista favorito">
                                                <i class="fas fa-star"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-block">
                                <i class="fas fa-microphone fa-2x"></i>
                                <p>No se encontraron artistas</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Bloque 4: Playlists -->
                <div class="dashboard-block playlists-block">
                    <div class="block-header">
                        <div class="header-info">
                            <h3><i class="fas fa-list"></i> Playlists Públicas</h3>
                            <span class="block-count">@playlists.Count resultado(s)</span>
                        </div>
                        <div class="header-border playlists-border"></div>
                    </div>
                    <div class="block-content">
                        @if (playlists.Any())
                        {
                            @foreach (var playlist in playlists)
                            {
                                <div class="playlist-item">
                                    <div class="playlist-icon">
                                        <i class="fas fa-list"></i>
                                    </div>
                                    <div class="playlist-details">
                                        <h4 class="playlist-name">@playlist.Name</h4>
                                        <p class="playlist-meta">
                                            @(playlist.PlaylistMusics?.Count ?? 0) canciones • @playlist.User?.FirstName @playlist.User?.LastName
                                        </p>
                                        @if (!string.IsNullOrEmpty(playlist.Description))
                                        {
                                            <p class="playlist-description">@playlist.Description</p>
                                        }
                                    </div>
                                    <div class="playlist-actions">
                                        <a href="@Url.Action("Details", "Playlists", new { id = playlist.Id })"
                                           class="action-btn view-btn" title="Ver playlist">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-block">
                                <i class="fas fa-list fa-2x"></i>
                                <p>No se encontraron playlists</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="no-results">
                <i class="fas fa-search fa-3x"></i>
                <h3>No se encontraron resultados</h3>
                <p>Intenta con términos diferentes o explora toda la música disponible</p>
                <a href="@Url.Action("Search")" class="explore-btn">
                    <i class="fas fa-compass"></i> Explorar Todo
                </a>
            </div>
        }

        <!-- Modal para agregar a playlist - TU MODAL ORIGINAL QUE FUNCIONA -->
        <div class="modal fade" id="addToPlaylistModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="fas fa-list"></i> Agregar a Playlist
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p>Agregar "<span id="songTitle"></span>" a:</p>
                        <div id="playlistsList">
                            <div class="text-center">
                                <i class="fas fa-spinner fa-spin"></i> Cargando playlists...
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <a asp-controller="Playlists" asp-action="Create" class="btn btn-success">
                            <i class="fas fa-plus"></i> Crear Nueva Playlist
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

}
else
{
    <!-- Redirección para no usuarios -->
    <div class="unauthorized-access">
        <i class="fas fa-lock fa-3x"></i>
        <h3>Acceso Restringido</h3>
        <p>Esta sección es solo para usuarios registrados.</p>
        <a href="@Url.Action("Index", "Home")" class="btn btn-primary">Volver al Inicio</a>
    </div>
}


<script src="~/js/search-dashboard.js"></script>
