<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SonikoMusic</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Application.MVC.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/LoginPartial.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gestion-music.css" />
    <link rel="stylesheet" href="~/css/notifications.css" asp-append-version="true" />

</head>

<body>
    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        <aside id="sidebar">
            <nav>
                <div class="container-fluid">
                    <div class="navbar-brand text-center">
                        <a class="navbar-brand text-white" asp-area="" asp-controller="Home" asp-action="Index">
                            <span class="nav-icon">SonikoMusic</span>
                        </a>
                    </div>
                    <ul class="navbar-nav flex-column">

                        <li class="nav-section"><div class="nav-title">PRINCIPAL</div></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index"><span class="nav-icon">🏠</span><span> Inicio</span></a></li>

                        @if (User.Identity!.IsAuthenticated)
                        {
                            @if (User.IsInRole("users"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Musics" asp-action="Search"><span class="nav-icon">🔍</span><span> Explorar</span></a></li>
                                
                                <li class="nav-section"><div class="nav-title">TU BIBLIOTECA</div></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="PlayLists" asp-action="Index"><span class="nav-icon">☰♪</span><span> PlayLists</span></a></li>
                                
                                <li class="nav-section"><div class="nav-title">PERSONAL</div></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Follows" asp-action="Index"><i class="fas fa-users-cog"></i> Gestión Follows</a></li>
                                <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Downloads")"><i class="fas fa-download"></i> Mis Descargas</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Favorites" asp-action="Index"><span class="nav-icon">❤️</span><span> Mis Favoritos</span></a></li>

                                                
                            }
                            @if (User.IsInRole("artists"))
                            {
                                <li class="nav-section"><div class="nav-title">TU MÚSICA</div></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Musics" asp-action="Index"><span class="nav-icon">🎵</span><span> Músicas</span></a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Musics" asp-action="Create"><span class="nav-icon">⬆️</span><span> Subir Música</span></a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Albums" asp-action="Index"><span class="nav-icon">📚</span><span> Álbums</span></a></li>
                                <li class="nav-section"><div class="nav-title">PERSONAL</div></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Follows" asp-action="Followers"><i class="fas fa-users"></i> Seguidores</a></li>
                            }
                            @if (User.IsInRole("admins"))
                            {
                                <li class="nav-section"><div class="nav-title">GESTIÓN</div></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="AdminDashboard" asp-action="Index"><span class="nav-icon">📊</span><span> Dashboard</span></a></li>

                                <li class="nav-section"><div class="nav-title">USUARIOS</div></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="AdminUsers" asp-action="Index"><span class="nav-icon">👥</span><span> Todos</span></a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="AdminUsers" asp-action="Artists"><span class="nav-icon">🎨</span><span> Artistas</span></a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="AdminUsers" asp-action="RegularUsers"><span class="nav-icon">👤</span><span> Usuarios</span></a></li>

                                <li class="nav-section"><div class="nav-title">CONTENIDO</div></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Musics" asp-action="Index"><span class="nav-icon">🎵</span><span> Músicas</span></a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Albums" asp-action="Index"><span class="nav-icon">📀</span><span> Álbumes</span></a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Playlists" asp-action="Index"><span class="nav-icon">📋</span><span> Playlists</span></a></li>

                                <li class="nav-section"><div class="nav-title">SISTEMA</div></li>
                                
                                <li class="nav-item"><a class="nav-link" asp-controller="SubscriptionPlans" asp-action="Index"><span class="nav-icon">💎</span><span> Planes</span></a></li>
                            }
                        }
                    </ul>
                </div>
            </nav>
        </aside>

        <!-- Page Content -->
        <div id="page-content-wrapper" class="flex-grow-1">
            <header id="soniko-header">
                <nav class="navbar navbar-expand-lg" id="soniko-navbar">
                    <div class="container-fluid">
                        <button id="toggleSidebar" class="btn btn-light d-md-none ms-2 mt-2"><i class="fas fa-bars"></i></button>
                        <button id="toggleSidebarDesktop" class="btn btn-outline-light d-none d-md-inline me-2"><i class="fas fa-bars"></i></button>
                        
                        @if (User.IsInRole("users"))
                        {
                           <div class="search-container flex-grow-1">
                            <form asp-controller="Musics" asp-action="Search" method="get" class="search-form">
                                <div class="search-input-group">
                                    <input type="text" name="query" placeholder="Buscar música, artistas..." class="search-input" aria-label="Buscar música o artistas" />
                                    <button type="submit" class="search-button">
                                        <i class="fas fa-search search-icon"></i>
                                        <span class="search-text">BUSCAR </span>
                                    </button>
                                </div>
                            </form>
                        </div>
                
                        }

                        
                        @if (User.IsInRole("users") || User.IsInRole("artists"))
                        {
                            <div class="notification-wrapper">
                                <partial name="_NotificationBell" />
                            </div>
                        }

                        <div class="d-flex">
                            @await Html.PartialAsync("_LoginPartial")
                        </div>
                    </div>
                </nav>
            </header>

            <main class="main-wrapper">
                <div class="container-fluid pt-4">
                    @RenderBody()
                </div>
                <footer id="soniko-footer">
                    &copy; 2025 - SonikoMusic 𐐘💥╾━╤デ╦︻ඞා
                </footer>
            </main>
        </div>
    </div>

    @if (User.IsInRole("users"))
    {     
        <!-- ⭐ REPRODUCTOR DE MÚSICA -->
        <div id="musicPlayer" style="display: none; position: fixed; bottom: 0; left: 0; right: 0; background: linear-gradient(135deg, rgba(0,0,0,0.95), rgba(20,20,20,0.98)); color: white; z-index: 9999; border-top: 1px solid rgba(102, 126, 234, 0.3); backdrop-filter: blur(15px); box-shadow: 0 -5px 25px rgba(0,0,0,0.5);">
        <div class="player-container">
            <!-- Barra de progreso superior -->
            <div class="top-progress-bar">
                <input type="range" id="progressBar" class="progress-slider" min="0" max="100" value="0" oninput="seekTo()" />
            </div>

            <div class="player-content">
                <!-- Información de la canción -->
                <div class="song-section">
                    <div class="song-artwork">
                        <i class="fas fa-music"></i>
                    </div>
                    <div class="song-info">
                        <div id="currentSong" class="song-title">
                            Canción seleccionada
                        </div>
                        <div class="song-artist">SonikoMusic</div>
                    </div>
                </div>

                <!-- Controles centrales -->
                <div class="controls-section">
                    <button id="prevBtn" class="control-btn secondary" onclick="previousTrack()" title="Anterior">
                        <i class="fas fa-step-backward"></i>
                    </button>
                    <button id="playPauseBtn" class="control-btn primary" onclick="togglePlayPause()" title="Reproducir/Pausar">
                        <i class="fas fa-play"></i>
                    </button>
                    <button id="nextBtn" class="control-btn secondary" onclick="nextTrack()" title="Siguiente">
                        <i class="fas fa-step-forward"></i>
                    </button>
                </div>

                <!-- Sección derecha con tiempo y controles adicionales -->
                <div class="time-section">
                    <div class="time-display">
                        <span id="currentTime">0:00</span>
                        <span class="time-separator">/</span>
                        <span id="duration">0:00</span>
                    </div>
                    <div class="extra-controls">
                        <button class="control-btn mini" onclick="setVolume(0.5)" title="Volumen">
                            <i class="fas fa-volume-up"></i>
                        </button>
                        <button id="stopBtn" class="control-btn mini" onclick="stopMusic()" title="Detener">
                            <i class="fas fa-stop"></i>
                        </button>
                        <button id="closePlayer" class="control-btn mini close" onclick="closePlayer()" title="Cerrar reproductor">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Audio element oculto -->
            <audio id="audioPlayer"
                   preload="metadata"
                   ontimeupdate="updateProgress()"
                   onended="onSongEnd()"
                   onloadedmetadata="updateProgress()">
            </audio>
        </div>
    </div>

    }






    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/soniko-player.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        const sidebar = document.getElementById('sidebar');
        const toggleSidebar = document.getElementById('toggleSidebar');
        const toggleSidebarDesktop = document.getElementById('toggleSidebarDesktop');

        toggleSidebar?.addEventListener('click', () => {
            sidebar.classList.toggle('active');
        });

        toggleSidebarDesktop?.addEventListener('click', () => {
            document.body.classList.toggle('sidebar-hidden');
        });
    </script>
</body>
</html>
