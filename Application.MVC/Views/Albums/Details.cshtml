<!-- Views/Albums/Details.cshtml -->
@model Application.Models.Album
@{
    ViewData["Title"] = "Detalles del Album";
}

<div class="details-container-album">
    <div class="container mt-4">
        <div class="row">
            <!-- Información del Album -->
            <div class="col-md-4">
                <div class="album-cover-large">
                    @if (!string.IsNullOrEmpty(Model.CoverImagePath))
                    {
                        <img src="@Model.CoverImagePath" alt="@Model.Name" class="img-fluid rounded" />
                    }
                    else
                    {
                        <div class="default-cover">
                            <i class="fas fa-compact-disc"></i>
                        </div>
                    }
                </div>

                <div class="album-info mt-3">
                    <h3>@Model.Name</h3>
                    <p class="artist-info">
                        <i class="fas fa-user"></i> @Model.Artist?.FirstName @Model.Artist?.LastName
                    </p>
                    <p class="release-info">
                        <i class="fas fa-calendar"></i> @Model.ReleaseDate.ToString("dd 'de' MMMM 'de' yyyy")
                    </p>
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="album-description">@Model.Description</div>
                    }

                    @if (ViewBag.IsReleased == false)
                    {
                        <div class="release-alert">
                            <i class="fas fa-clock"></i>
                            <strong>Álbum programado para:</strong> @Model.ReleaseDate.ToString("dd/MM/yyyy")
                        </div>
                    }

                    <!-- Botones de acción -->
                    <div class="album-actions mt-3">
                        @if (ViewBag.IsOwner == true)
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-album btn-edit">
                                <i class="fas fa-edit"></i> Editar
                            </a>
                            <a asp-action="ManageMusics" asp-route-id="@Model.Id" class="btn-album btn-manage">
                                <i class="fas fa-cog"></i> Gestionar Música
                            </a>
                        }
                        <a asp-action="Index" class="btn-album btn-back">
                            <i class="fas fa-arrow-left"></i> Volver
                        </a>
                    </div>
                </div>
            </div>

            <!-- Lista de Músicas -->
            <div class="col-md-8">
                <div class="album-tracks">
                    <div class="tracks-header">
                        <h4><i class="fas fa-music"></i> Canciones del Album</h4>
                        @if (Model.Musics?.Any() == true)
                        {
                            <span class="tracks-count">@Model.Musics.Count canción(es)</span>
                        }
                    </div>

                    @if (Model.Musics?.Any() == true)
                    {
                        <div class="tracks-list">
                            @foreach (var music in Model.Musics.OrderBy(m => m.Title))
                            {
                                <div class="track-item">
                                    <div class="track-info">
                                        <div class="track-number">
                                            @(Model.Musics.ToList().IndexOf(music) + 1)
                                        </div>
                                        <div class="track-details">
                                            <h6 class="track-title">@music.Title</h6>
                                            <p class="track-meta">
                                                <span class="track-genre">@music.Genre.ToString()</span>
                                                @if (!string.IsNullOrEmpty(music.Duration))
                                                {
                                                    <span class="track-duration"> • @music.Duration</span>
                                                }
                                            </p>
                                        </div>
                                    </div>
                                    <div class="track-actions">
                                        @if (User.IsInRole("users"))
                                        {
                                            <button class="btn-track btn-play"
                                                    onclick="playMusic(@music.Id, '@music.Title', '@music.Artist?.FirstName @music.Artist?.LastName', '/files/@music.FilePath')"
                                                    title="Reproducir">
                                                <i class="fas fa-play"></i>
                                            </button>

                                            <button class="btn-track btn-add"
                                                    onclick="showAddToPlaylistModal(@music.Id, '@music.Title')"
                                                    title="Agregar a playlist">
                                                <i class="fas fa-plus"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("Details", "Musics", new { id = music.Id })" class="btn-track btn-details" title="Ver detalles">
                                                <i class="fas fa-info-circle"></i>
                                            </a>
                                        }
                                    </div>

                                </div>
                            }
                        </div>

                        
                        <!-- Botón para reproducir todo -->
                        @if (User.IsInRole("users"))
                        {
                            <div class="album-player">
                                <button class="btn-play-album" onclick="playAlbum()">
                                    <i class="fas fa-play"></i> Reproducir Album Completo
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="no-tracks">
                            <i class="fas fa-music fa-3x"></i>
                            <h5>No hay canciones en este album</h5>
                            <p>Las canciones aparecerán aquí cuando se suban con este album asignado.</p>

                            @if (ViewBag.IsOwner == true)
                            {
                                <a asp-controller="Musics" asp-action="Create" class="btn-album btn-primary">
                                    <i class="fas fa-plus"></i> Subir Primera Canción
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para agregar a playlist -->
@if (User.Identity.IsAuthenticated)
{
    <div class="modal fade" id="addToPlaylistModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content modal-custom">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-list"></i> Agregar a Playlist
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Agregar "<span id="songTitle"></span>" a:</p>
                    <div id="playlistsList">
                        <div class="text-center">
                            <i class="fas fa-spinner fa-spin"></i> Cargando playlists...
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <a asp-controller="Playlists" asp-action="Create" class="btn btn-success">
                        <i class="fas fa-plus"></i> Crear Nueva Playlist
                    </a>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .details-container-album {
        background: linear-gradient(135deg, #667eea00 0%, #4b5ba274 100%);
        min-height: 100vh;
        padding: 30px 20px;
        color: #2c3e50; /* Color oscuro para texto principal */
    }

        .details-container-album .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .details-container-album .row {
            background: rgba(255, 255, 255, 0.85);
            border-radius: 20px;
            padding: 30px;
            backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }

        .details-container-album .col-md-4 {
            border-right: 1px solid rgba(0, 0, 0, 0.1);
            padding-right: 30px;
        }

        .details-container-album .col-md-8 {
            padding-left: 30px;
        }

    @@media (max-width: 768px) {
        .details-container-album .col-md-4

    {
        border-right: none;
        border-bottom: 1px solid rgba(0, 0, 0, 0.1);
        padding-right: 15px;
        padding-bottom: 20px;
        margin-bottom: 20px;
    }

    .details-container-album .col-md-8 {
        padding-left: 15px;
    }

    .details-container-album .row {
        padding: 20px;
    }

    }

    .album-cover-large {
        text-align: center;
    }

    .default-cover {
        width: 100%;
        height: 300px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        color: white;
        font-size: 80px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    .album-info h3 {
        font-size: 2.2rem;
        font-weight: bold;
        margin-bottom: 0.5rem;
        color: #2c3e50;
    }

    .artist-info, .release-info {
        color: #5a6c7d;
        font-size: 1.1rem;
        margin-bottom: 0.8rem;
    }

        .artist-info i, .release-info i {
            color: #667eea;
            margin-right: 8px;
        }

    .album-description {
        background: rgba(102, 126, 234, 0.1);
        padding: 20px;
        border-radius: 15px;
        border-left: 4px solid #667eea;
        margin-top: 20px;
        color: #2c3e50;
        line-height: 1.6;
    }

    .release-alert {
        background: rgba(255, 193, 7, 0.15);
        padding: 15px;
        border-radius: 10px;
        border-left: 4px solid #ffc107;
        margin-top: 15px;
        color: #856404;
    }

    .album-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn-album {
        padding: 12px 20px;
        border-radius: 25px;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.9rem;
    }

    .btn-edit {
        background: linear-gradient(45deg, #28a745, #20c997);
        color: white;
    }

    .btn-manage {
        background: linear-gradient(45deg, #667eea, #764ba2);
        color: white;
    }

    .btn-back {
        background: linear-gradient(45deg, #6c757d, #5a6268);
        color: white;
    }

    .btn-primary {
        background: linear-gradient(45deg, #007bff, #0056b3);
        color: white;
    }

    .btn-album:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
        text-decoration: none;
        color: white;
    }

    .tracks-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 2px solid rgba(102, 126, 234, 0.2);
    }

        .tracks-header h4 {
            color: #2c3e50;
            margin: 0;
            font-size: 1.5rem;
        }

    .tracks-count {
        background: linear-gradient(45deg, #667eea, #764ba2);
        color: white;
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 500;
    }

    .tracks-list {
        background: rgba(255, 255, 255, 0.7);
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
        border: 1px solid rgba(102, 126, 234, 0.1);
    }

    .track-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 25px;
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        transition: all 0.3s ease;
    }

        .track-item:hover {
            background: rgba(102, 126, 234, 0.05);
            transform: translateX(5px);
        }

        .track-item:last-child {
            border-bottom: none;
        }

    .track-info {
        display: flex;
        align-items: center;
        flex: 1;
    }

    .track-number {
        width: 35px;
        height: 35px;
        background: linear-gradient(45deg, #667eea, #764ba2);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        margin-right: 20px;
        font-size: 15px;
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
    }

    .track-details {
        flex: 1;
    }

    .track-title {
        margin: 0 0 6px 0;
        font-size: 17px;
        font-weight: 600;
        color: #2c3e50;
    }

    .track-meta {
        margin: 0;
        font-size: 14px;
        color: #6c757d;
    }

    .track-genre {
        background: rgba(102, 126, 234, 0.1);
        color: #667eea;
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 500;
    }

    .track-duration {
        color: #8e9aaf;
    }

    .track-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-track {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        font-size: 14px;
    }

    .btn-play {
        background: linear-gradient(45deg, #28a745, #20c997);
        color: white;
    }

    .btn-add {
        background: linear-gradient(45deg, #667eea, #764ba2);
        color: white;
    }

    .btn-track:hover {
        transform: scale(1.1);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }

    .album-player {
        text-align: center;
        margin-top: 30px;
        padding-top: 25px;
        border-top: 2px solid rgba(102, 126, 234, 0.1);
    }

    .btn-play-album {
        background: linear-gradient(45deg, #28a745, #20c997);
        color: white;
        border: none;
        padding: 15px 40px;
        border-radius: 30px;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 8px 25px rgba(40, 167, 69, 0.3);
    }

        .btn-play-album:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 35px rgba(40, 167, 69, 0.4);
        }

    .no-tracks {
        text-align: center;
        padding: 60px 30px;
        background: rgba(248, 249, 250, 0.8);
        border-radius: 15px;
        margin: 20px 0;
        border: 2px dashed rgba(102, 126, 234, 0.3);
    }

        .no-tracks i {
            color: rgba(102, 126, 234, 0.6);
            margin-bottom: 20px;
        }

        .no-tracks h5 {
            color: #2c3e50;
            margin-bottom: 15px;
        }

        .no-tracks p {
            color: #6c757d;
            margin-bottom: 25px;
        }

    /* Modal personalizado */
    .modal-custom {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(15px);
        border-radius: 15px;
        border: 1px solid rgba(102, 126, 234, 0.2);
    }

        .modal-custom .modal-header {
            border-bottom: 1px solid rgba(102, 126, 234, 0.2);
            background: linear-gradient(45deg, #667eea, #764ba2);
            color: white;
            border-radius: 15px 15px 0 0;
        }

        .modal-custom .modal-body {
            color: #2c3e50;
        }
</style>

<script>
    let currentMusicId = 0;

    function showAddToPlaylistModal(musicId, songTitle) {
        currentMusicId = musicId;
        document.getElementById('songTitle').textContent = songTitle;

        // Mostrar modal
        new bootstrap.Modal(document.getElementById('addToPlaylistModal')).show();

        // Simular carga
        setTimeout(() => {
            document.getElementById('playlistsList').innerHTML =
                '<p class="text-muted">Funcionalidad en desarrollo.</p>';
        }, 1000);
    }

    function playMusic(musicId, title, artist, filePath) {
        // Integración con tu reproductor existente
        if (typeof window.setCurrentTrack === 'function') {
            window.setCurrentTrack(filePath, title, artist);
            window.playAudio();
        } else {
            alert('Reproduciendo: ' + title + ' - ' + artist);
        }
    }

    function playAlbum() {
        // Funcionalidad para reproducir todo el album
        alert('Reproducir album completo - por implementar');
    }
</script>