<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SonikoMusic</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Application.MVC.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/LoginPartial.css" asp-append-version="true" />
    
</head>


<body>
    <header id="soniko-header" >
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm" id="soniko-navbar">
            <div class="container-fluid">
                
                <!-- Search Bar -->
                <div class="search-container flex-grow-1 mx-3">
                    <form asp-controller="Musics" asp-action="Search" method="get" class="search-form">
                        <div class="search-input-group">
                            <input type="text"
                                   name="query"
                                   placeholder="Buscar música, artistas..."
                                   class="search-input"
                                   aria-label="Buscar música o artistas" />
                            <button type="submit" class="search-button">
                                <i class="fas fa-search search-icon"></i>
                                <span class="search-text">BUSCAR</span>
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Login/Register or User Menu -->
                <div class="d-flex">
                    @await Html.PartialAsync("_LoginPartial")
                </div>

                <!-- Mobile toggle -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>
        </nav>
    </header>
    <aside>
        <nav>
            
            <div class="container-fluid">
                <div class="navbar-brand">
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <span class="nav-icon">SonikoMusic</span>
                     
                    </a>
                </div>
                <ul class="navbar-nav flex-column">
                    <!-- Sección Principal -->
                    <div class="nav-section">
                        <div class="nav-title">PRINCIPAL</div>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <span class="nav-icon">🏠</span>
                            <span>Inicio</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Musics" asp-action="SearchResults">
                            <span class="nav-icon">🔍</span>
                            <span>Explorar</span>
                        </a>
                    </li>
            </div>

            <!-- Sección Música -->
            <div class="nav-section">
                <div class="nav-title">TU MÚSICA</div>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Musics" asp-action="Index">
                        <span class="nav-icon">🎵</span>
                        <span>Músicas</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Musics" asp-action="Create">
                        <span class="nav-icon">⬆️</span>
                        <span>Subir Música</span>
                    </a>
                </li>
                
            </div>

            <!-- Sección Personal -->
            <div class="nav-section">
                <div class="nav-title">PERSONAL</div>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="PlayLists" asp-action="Index">
                        <span class="nav-icon">❤️</span>
                        <span>PlayLists</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Albums" asp-action="Index">
                        <span class="nav-icon">📚</span>
                        <span>Álbums</span>
                    </a>
                </li>
            </div>
            </ul>
            </div>
        </nav>
    </aside>


    <div class="main-wrapper" id="soniko-main">
        <div class="container-fluid">
            <main role="main" class="pb-3" style="background-color: rgba(195, 195, 195, 0.135)">
                @RenderBody()
            </main>
        </div>

        <footer id="soniko-footer">
            &copy; 2025 - SonikoMusic 
        </footer>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/soniko-player.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Reproductor de música fijo -->
    <div id="musicPlayer" class="music-player" style="display: none;">
        <div class="player-content">
            <div class="song-info">
                <span id="currentSong">Ninguna canción seleccionada</span>
            </div>
            <div class="player-controls">
                <button id="prevBtn" onclick="previousTrack()" title="Anterior">⏮️</button>
                <button id="playPauseBtn" onclick="togglePlayPause()">▶️</button>
                <button id="nextBtn" onclick="nextTrack()" title="Siguiente">⏭️</button>
                <button onclick="stopMusic()">⏹️</button>
            </div>
            <div class="progress-container">
                <input type="range" id="progressBar" min="0" max="100" value="0" onchange="seekTo()">
                <span id="currentTime">0:00</span> / <span id="duration">0:00</span>
            </div>
        </div>
        <audio id="audioPlayer" ontimeupdate="updateProgress()" onended="onSongEnd()"></audio>
    </div>

</body>
</html>