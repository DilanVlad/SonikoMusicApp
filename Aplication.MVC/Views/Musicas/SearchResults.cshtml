@model IEnumerable<Aplication.Modelos.Musica>

@{
    ViewData["Title"] = "Resultados de búsqueda";
}

<h2>Resultados para: "@ViewBag.SearchQuery"</h2>

<p>
    <a asp-action="Create">Subir nueva música</a>
</p>

@if (Model.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Título</th>
                <th>Artista</th>
                <th>Duración</th>
                <th>Fecha</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Titulo)</td>
                    <td>@Html.DisplayFor(modelItem => item.Artista.Nombre)</td>
                    <td>@Html.DisplayFor(modelItem => item.Duracion)</td>
                    <td>@Html.DisplayFor(modelItem => item.FechaSubida)</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No se encontraron resultados para "@ViewBag.SearchQuery"</p>
    <p><a asp-action="Index">Volver al listado completo</a></p>
}