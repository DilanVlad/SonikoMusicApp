@using Microsoft.AspNetCore.Identity
@using Application.Models.Identity
@using Application.API.Consumer
@using Application.Models.Suscription
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <div class="dropdown">
        <button class="user-dropdown-btn d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
            <div class="user-avatar">
                @{
                    var user = await UserManager.GetUserAsync(User);
                    var avatarText = User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U";
                    var roles = await UserManager.GetRolesAsync(user);
                    var userRole = roles.FirstOrDefault();

                    // Obtener plan actual del usuario
                    UserSubscription currentSubscription = null;
                    try
                    {
                        using (var client = new HttpClient())
                        {
                            var response = await client.GetAsync($"https://localhost:7095/api/UserSubscriptions/user/{user.Id}/active");
                            if (response.IsSuccessStatusCode)
                            {
                                var json = await response.Content.ReadAsStringAsync();
                                currentSubscription = Newtonsoft.Json.JsonConvert.DeserializeObject<UserSubscription>(json);
                            }
                        }
                    }
                    catch { }

                    var planName = currentSubscription?.SubscriptionPlan?.Name ?? "Gratuito";
                }
                <span class="avatar-letter">@avatarText</span>
            </div>
            <span class="user-name">@User.Identity.Name</span>
            <i class="fas fa-caret-down"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end p-2">
            <li class="dropdown-header d-flex align-items-center gap-2 px-3 py-2">
                <div class="role-badge @userRole">
                    @switch (userRole)
                    {
                        case "admins":
                            <i class="fas fa-shield-alt me-1"></i>
                            <span>Administrador</span>
                            break;
                        case "artists":
                            <i class="fas fa-palette me-1"></i>
                            <span>Artista</span>
                            break;
                        default:
                            <i class="fas fa-user me-1"></i>
                            <span>Usuario</span>
                            break;
                    }
                </div>
            </li>

            
            @if (userRole == "users")
            {
                <li class="dropdown-header d-flex align-items-center gap-2 px-3 py-1">
                    <div class="role-badge users">
                        <i class="fas fa-play me-1" style="transform: rotate(90deg);"></i>
                        <span>Plan @planName</span>
                    </div>
                </li>
            }

            <li><hr class="dropdown-divider my-2"></li>
            <li>
                <a class="dropdown-item d-flex align-items-center gap-2 px-3 py-2" asp-controller="Account" asp-action="Profile">
                    <i class="fas fa-user-edit"></i>
                    <span>Mi perfil</span>
                </a>
            </li>

            @* Solo mostrar "Mejorar Plan" a usuarios normales *@
            @if (userRole == "users")
            {
                <li>
                    <a class="dropdown-item d-flex align-items-center gap-2 px-3 py-2" asp-controller="UserSubscriptions" asp-action="Plans">
                        <i class="fas fa-crown"></i>
                        <span>Mejorar Plan</span>
                    </a>
                </li>
            }

            @if (userRole == "artists")
            {
                <li>
                    <a class="dropdown-item d-flex align-items-center gap-2 px-3 py-2" asp-controller="Musics" asp-action="Index">
                        <i class="fas fa-music"></i>
                        <span>Mis canciones</span>
                    </a>
                </li>
            }
            @if (userRole == "admins")
            {
                <li>
                    <a class="dropdown-item d-flex align-items-center gap-2 px-3 py-2" asp-controller="UserSubscriptions" asp-action="Index">
                        <i class="fas fa-cog"></i>
                        <span>Panel admin</span>
                    </a>
                </li>
            }
            <li><hr class="dropdown-divider my-2"></li>
            <li>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")" method="post" class="d-inline">
                    <button type="submit" class="dropdown-item d-flex align-items-center gap-2 px-3 py-2 text-danger">
                        <i class="fas fa-sign-out-alt"></i>
                        <span>Cerrar sesión</span>
                    </button>
                </form>
            </li>
        </ul>
    </div>
}
else
{
    <div class="auth-buttons d-flex gap-2">
        <a class="btn login-btn d-flex align-items-center gap-2" asp-controller="Account" asp-action="Login">
            <i class="fas fa-sign-in-alt"></i>
            <span>Iniciar sesión</span>
        </a>
        <a class="btn register-btn d-flex align-items-center gap-2" asp-controller="Account" asp-action="Register">
            <i class="fas fa-user-plus"></i>
            <span>Registrarse</span>
        </a>
    </div>
}