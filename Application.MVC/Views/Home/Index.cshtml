@{
    ViewData["Title"] = "Inicio";
}

@using Microsoft.AspNetCore.Identity
@using System.Security.Claims

@{
    var user = Context.User;
}

@if (!user.Identity!.IsAuthenticated)
{
    <div class="hero-panel">
        <h1 class="hero-title">Bienvenido a <span style="color:#00f7ff;">SonikoMusic</span></h1>
        <p class="hero-subtitle">La plataforma donde los artistas independientes y los amantes de la música se encuentran.</p>
        <div class="hero-actions">
            <a class="btn btn-glow" asp-area="" asp-controller="Account" asp-action="Register"> Únete Ahora </a>
            <a class="btn btn-outline" asp-area="" asp-controller="Account" asp-action="Login"> Iniciar Sesión </a>

        </div>
    </div>

    <div class="feature-section">
        <div class="feature-card">
            <h3>🎧 Descubre</h3>
            <p>Explora una variedad de estilos musicales creados por artistas emergentes de todo el mundo.</p>
        </div>
        <div class="feature-card">
            <h3>🎶 Crea</h3>
            <p>Arma tus propias playlists con tus canciones favoritas y llévalas donde quieras.</p>
        </div>
        <div class="feature-card">
            <h3>💬 Conecta</h3>
            <p>Conviértete en parte de una comunidad apasionada por la música. Sigue artistas y comparte lo que amas.</p>
        </div>
    </div>

}
else if (user.IsInRole("admins"))
{
    <div class="hero-panel">
        <h1 class="hero-title">Panel de Administración</h1>
        <p class="hero-subtitle">Gestiona el ecosistema musical de SonikoMusic con control total y visibilidad completa.</p>
    </div>

    <div class="feature-section">
        <div class="feature-card">
            <h3>🛠️ Gestión de Usuarios</h3>
            <p>Visualiza y administra las cuentas de usuarios, artistas y moderadores registrados.</p>
        </div>
        <div class="feature-card">
            <h3>🔎 Moderación de Contenido</h3>
            <p>Supervisa canciones, álbumes y perfiles para asegurar que todo cumpla las políticas.</p>
        </div>
        <div class="feature-card">
            <h3>📊 Reportes y Estadísticas</h3>
            <p>Accede a datos clave sobre actividad, tráfico, y comportamiento dentro de la plataforma.</p>
        </div>
    </div>

}
else if (user.IsInRole("artists"))
{
    <div class="hero-panel">
        <h1 class="hero-title">¡Bienvenido, Artista!</h1>
        <p class="hero-subtitle">Este es tu espacio para brillar. Publica, conecta y haz que tu música vuele alto.</p>
    </div>

    <div class="feature-section">
        <div class="feature-card">
            <h3>🎤 Publica tu Música</h3>
            <p>Sube canciones, álbumes y comparte tu esencia con miles de oyentes en todo el mundo.</p>
        </div>
        <div class="feature-card">
            <h3>📈 Analiza tu Impacto</h3>
            <p>Consulta estadísticas detalladas sobre reproducciones, seguidores y favoritos.</p>
        </div>
        <div class="feature-card">
            <h3>🤝 Conecta con tus Fans</h3>
            <p>Recibe apoyo, comentarios y forma una comunidad que te respalde en cada paso.</p>
        </div>
    </div>

}
else if (user.IsInRole("users"))
{
    <div class="hero-panel">
        <h1 class="hero-title">¡Hola de nuevo!</h1>
        <p class="hero-subtitle">Sumérgete en tu mundo musical. Disfruta, crea y apoya a tus artistas favoritos.</p>
    </div>

    <div class="feature-section">
        <div class="feature-card">
            <h3>🔍 Explora Música</h3>
            <p>Descubre nuevas canciones cada día y sumérgete en distintos géneros y culturas.</p>
        </div>
        <div class="feature-card">
            <h3>📂 Tus Playlists</h3>
            <p>Organiza tus temas favoritos en listas personalizadas y escúchalas cuando quieras.</p>
        </div>
        <div class="feature-card">
            <h3>🎁 Apoya Talento</h3>
            <p>Valora el trabajo de artistas independientes con cada reproducción y seguimiento.</p>
        </div>
    </div>

}
