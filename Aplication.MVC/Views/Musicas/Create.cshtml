@model Aplication.Modelos.Musica

@{
    ViewData["Title"] = "Subir Música";
}

<h1>Subir Nueva Música</h1>

<h4>Información de la canción</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Campos que el usuario debe llenar -->
            <div class="form-group">
                <label asp-for="Titulo" class="control-label">Título de la canción</label>
                <input asp-for="Titulo" class="form-control" placeholder="Ingresa el título de tu canción" />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label for="ArchivoMusica" class="control-label">Archivo de Audio</label>
                <input type="file" name="ArchivoMusica" class="form-control" accept=".mp3,.wav,.m4a" />
                <small class="form-text text-muted">Formatos permitidos: MP3, WAV, M4A</small>
            </div>

            <div class="form-group">
                <label asp-for="Duracion" class="control-label">Duración</label>
                <input asp-for="Duracion" class="form-control" placeholder="ej: 3:45" />
                <span asp-validation-for="Duracion" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Letra" class="control-label">Letra (Opcional)</label>
                <textarea asp-for="Letra" class="form-control" rows="8" placeholder="Ingresa la letra de tu canción (opcional)"></textarea>
                <span asp-validation-for="Letra" class="text-danger"></span>
            </div>

            <!-- Campos ocultos que se establecen automáticamente -->
            <input type="hidden" asp-for="FechaSubida" />
            <input type="hidden" asp-for="EsActiva" value="true" />
            <input type="hidden" asp-for="CalificacionPromedio" value="0" />
            <input type="hidden" asp-for="TotalCalificaciones" value="0" />
            <input type="hidden" asp-for="Reproducciones" value="0" />
            <input type="hidden" asp-for="Descargas" value="0" />
            <input type="hidden" asp-for="RutaArchivo" />

            <!-- ArtistaId se establecerá desde el controlador basado en el usuario logueado -->
            <input type="hidden" asp-for="ArtistaId" />

            <!-- AlbumId es opcional por ahora -->
            <input type="hidden" asp-for="AlbumId" />

            <div class="form-group">
                <input type="submit" value="Subir Música" class="btn btn-success" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>

    <!-- Panel de información -->
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>Información importante</h5>
            </div>
            <div class="card-body">
                <ul>
                    <li>Solo archivos de audio son permitidos</li>
                    <li>Tamaño máximo: 50MB</li>
                    <li>La música será revisada antes de ser publicada</li>
                    <li>Asegúrate de tener los derechos de la música</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}