@model Application.Models.Implementations.Download
@{
    ViewData["Title"] = "Nueva Descarga";
}

<link rel="stylesheet" href="~/css/downloads.css" />

<div class="downloads-container">
    <div class="container">
        <div class="downloads-header">
            <h1 class="downloads-title">
                <i class="fas fa-plus"></i> Nueva Descarga
            </h1>
        </div>

        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="downloads-form">
                    <form asp-action="Create">
                        <div class="form-group-downloads">
                            <label asp-for="MusicId" class="form-label-downloads">Música</label>
                            <select asp-for="MusicId" class="form-control-downloads">
                                <option value="">-- Seleccionar Música --</option>
                                <!-- Se necesitará llenar desde el controlador -->
                            </select>
                            <span asp-validation-for="MusicId" class="text-danger"></span>
                        </div>

                        <div class="form-group-downloads">
                            <label asp-for="LocalFilePath" class="form-label-downloads">Ruta Local (Opcional)</label>
                            <input asp-for="LocalFilePath" class="form-control-downloads" placeholder="Ej: /downloads/musica.mp3" />
                            <span asp-validation-for="LocalFilePath" class="text-danger"></span>
                        </div>

                        <div class="downloads-actions">
                            <button type="submit" class="btn-downloads btn-primary-downloads">
                                <i class="fas fa-save"></i> Crear Descarga
                            </button>
                            <a href="@Url.Action("Index")" class="btn-downloads btn-secondary-downloads">
                                <i class="fas fa-arrow-left"></i> Volver
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
